---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import LayerDemo from "../components/LayerDemo.astro";
import TypingDemo from "../components/TypingDemo.astro";
import TypingPractice from "../components/TypingPractice.astro";
import GetStarted from "../components/GetStarted.astro";
import Faq from "../components/Faq.astro";
import Subscribe from "../components/Subscribe.astro";
import ShareButtons from "../components/ShareButtons.astro";
import GitHubSupport from "../components/GitHubSupport.astro";

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "新月配列",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "macOS, Windows, Linux",
  description:
    "月配列2-263 をベースに、濁音・半濁音・小書きを「清音 + ゛」の後置規則に統合したかな配列。標準 US（ANSI）キーボードの英字 3 行 30 キーで動作し、同時押しを使わない。",
  url: "https://shingetsu-layout.com",
  inLanguage: "ja",
  offers: { "@type": "Offer", price: "0", priceCurrency: "JPY" },
  author: {
    "@type": "Person",
    "@id": "https://shingetsu-layout.com/#author",
    name: "nagamine",
    url: "https://github.com/nagamine-git",
  },
};
---

<Base
  title="新月配列 — 濁音を覚えない、30 キーのかな配列"
  description="新月配列は、月配列2-263 をベースに濁音・半濁音・小書きを「清音 + ゛」の 1 つの規則に統合したかな配列です。標準 US（ANSI）キーボードの英字 3 行 30 キーだけで動き、同時押しを使いません。"
  ogImage="/og/home.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>

  <Hero />
  <Features />
  <LayerDemo />
  <TypingDemo />
  <TypingPractice />
  <div class="mx-auto max-w-3xl px-4 py-8">
    <GitHubSupport location="home-after-demo" />
  </div>
  <GetStarted />
  <Faq />
  <Subscribe />
  <div class="max-w-xl mx-auto px-4 pb-24">
    <ShareButtons loc="home" />
  </div>
</Base>
