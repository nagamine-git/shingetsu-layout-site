---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import LayerDemo from "../components/LayerDemo.astro";
import TypingDemo from "../components/TypingDemo.astro";
import TypingPractice from "../components/TypingPractice.astro";
import GetStarted from "../components/GetStarted.astro";
import Faq from "../components/Faq.astro";
import Subscribe from "../components/Subscribe.astro";
import ShareButtons from "../components/ShareButtons.astro";
import GitHubSupport from "../components/GitHubSupport.astro";

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "新月配列",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "macOS, Windows, Linux",
  description:
    "新月配列は、いつものキーボードのまま、ローマ字入力の約 1.7 倍の効率（統一ベンチマークの推定時間: QWERTY 3.195 → 新月 1.887）で日本語を打てるかな配列です。特別なキーボードも同時押しも不要。設定ファイル 1 つで導入でき、いつでも元に戻せます。月配列 2-263 直系。",
  url: "https://shingetsu-layout.com",
  inLanguage: "ja",
  offers: { "@type": "Offer", price: "0", priceCurrency: "JPY" },
  author: {
    "@type": "Person",
    "@id": "https://shingetsu-layout.com/#author",
    name: "nagamine",
    url: "https://github.com/nagamine-git",
  },
};
---

<Base
  title="新月配列 — いつものキーボードで、ローマ字の 1.7 倍の効率を"
  description="新月配列は、いつものキーボードのまま、ローマ字入力の約 1.7 倍の効率（統一ベンチマークの推定時間: QWERTY 3.195 → 新月 1.887）で日本語を打てるかな配列です。特別なキーボードも同時押しも不要。設定ファイル 1 つで導入でき、いつでも元に戻せます。月配列 2-263 直系。"
  ogImage="/og/home.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>

  <Hero />
  <Features />
  <LayerDemo />
  <TypingDemo />
  <TypingPractice />
  <div class="mx-auto max-w-3xl px-4 py-8">
    <GitHubSupport location="home-after-demo" />
  </div>
  <GetStarted />
  <Faq />
  <Subscribe />
  <div class="max-w-xl mx-auto px-4 pb-24">
    <ShareButtons loc="home" />
  </div>
</Base>
