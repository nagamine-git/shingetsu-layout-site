<div class="eclipse" aria-hidden="true">
  <div class="eclipse-halo"></div>
  <div class="eclipse-disc">
    <svg class="eclipse-grain" viewBox="0 0 600 600" focusable="false">
      <filter id="lunar-grain" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency=".025" numOctaves="4" seed="8" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer><feFuncR type="gamma" amplitude="1" exponent="2.2" offset="0" /><feFuncG type="gamma" amplitude="1" exponent="2.2" offset="0" /><feFuncB type="gamma" amplitude="1" exponent="2.2" offset="0" /></feComponentTransfer>
      </filter>
      <circle cx="300" cy="300" r="298" fill="#8b8379" filter="url(#lunar-grain)" />
    </svg>
  </div>
  <svg class="eclipse-phase" viewBox="0 0 600 600" focusable="false">
    <defs>
      <linearGradient id="lunar-phase-light" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#777e89" />
        <stop offset=".65" stop-color="#c9cdd3" />
        <stop offset="1" stop-color="#f1ede5" />
      </linearGradient>
      <mask id="lunar-phase-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="600" height="600">
        <circle cx="300" cy="300" r="300" fill="white" />
        <circle class="eclipse-phase-shadow" cx="300" cy="300" r="301" fill="black" />
      </mask>
    </defs>
    <g mask="url(#lunar-phase-mask)">
      <circle cx="300" cy="300" r="300" fill="url(#lunar-phase-light)" />
      <circle cx="300" cy="300" r="300" filter="url(#lunar-grain)" opacity=".25" />
    </g>
  </svg>
  <svg class="eclipse-film" viewBox="0 0 600 600" focusable="false">
    <filter id="lunar-film" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency=".72" numOctaves="2" seed="17" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="600" height="600" filter="url(#lunar-film)" />
  </svg>
  <div class="eclipse-contact"></div>
</div>
