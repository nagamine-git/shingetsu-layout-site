---
const TURNSTILE_SITE_KEY = "0x4AAAAAACpKgDYvdZmNv-bB";
---

<section id="subscribe" class="content-section subscribe-section">
  <div class="max-w-xl mx-auto text-center">
    <p class="section-index" aria-hidden="true">07 / STAY IN ORBIT</p>
    <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
      アップデートを受け取る
    </h2>
    <p class="text-slate-400 mb-10">
      新月配列の最新情報、チュートリアル、リリースノートをメールでお届けします。
      スパムは送りません。いつでも解除できます。
    </p>

    <div class="rounded-2xl border border-white/10 bg-[var(--color-surface-2)] p-8">
      <form id="subscribe-form" novalidate class="space-y-4">
        <div>
          <label for="sub-email" class="block text-left text-sm text-slate-400 mb-1">
            メールアドレス <span class="text-red-400">*</span>
          </label>
          <input
            id="sub-email"
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-white/10 text-white placeholder:text-slate-600 focus:outline-none focus:border-brand-500 transition-colors"
          />
        </div>

        <!-- Turnstile widget -->
        <div
          class="cf-turnstile mx-auto"
          data-sitekey={TURNSTILE_SITE_KEY}
          data-theme="dark"
          data-callback="onTurnstileSuccess"
          data-error-callback="onTurnstileError"
        ></div>

        <button
          id="sub-btn"
          type="submit"
          disabled
          class="w-full py-3 rounded-lg bg-brand-600 hover:bg-brand-500 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold transition-all duration-200"
        >
          登録する
        </button>

        <p id="sub-msg" class="text-sm hidden"></p>
      </form>
    </div>
  </div>
</section>

<script>
  // Turnstile script はスクロールで Subscribe セクションが近づいてから遅延ロード
  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting) {
        const s = document.createElement("script");
        s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
        s.async = true;
        s.defer = true;
        document.head.appendChild(s);
        observer.disconnect();
      }
    },
    { rootMargin: "200px" }
  );
  const section = document.getElementById("subscribe");
  if (section) observer.observe(section);
</script>

<script>
  // 事前登録は廃止したので、購読種別はニュースレター固定（API の VALID_TYPES と対応）
  const SUBSCRIBE_TYPE = "newsletter";
  let turnstileToken = "";

  (window as Record<string, unknown>)["onTurnstileSuccess"] = (token: string) => {
    turnstileToken = token;
    const btn = document.getElementById("sub-btn") as HTMLButtonElement | null;
    if (btn) btn.disabled = false;
  };

  (window as Record<string, unknown>)["onTurnstileError"] = () => {
    turnstileToken = "";
    const btn = document.getElementById("sub-btn") as HTMLButtonElement | null;
    if (btn) btn.disabled = true;
  };

  const form = document.getElementById("subscribe-form") as HTMLFormElement | null;
  const msg = document.getElementById("sub-msg") as HTMLElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !msg) return;

    const emailEl = form.querySelector<HTMLInputElement>("#sub-email");
    const btn = form.querySelector<HTMLButtonElement>("#sub-btn");

    // 黙って return すると「押しても何も起きない」になるため、必ず理由を表示する
    if (!emailEl || !btn) {
      msg.textContent = "フォームを読み込めませんでした。ページを再読み込みしてお試しください。";
      msg.className = "text-sm text-red-400";
      msg.classList.remove("hidden");
      return;
    }

    btn.disabled = true;
    btn.textContent = "送信中…";

    // Retention: 購読フォームの送信（継続接点の獲得トライ）
    window.track("subscribe_submit", { type: SUBSCRIBE_TYPE });

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: emailEl.value,
          type: SUBSCRIBE_TYPE,
          turnstileToken,
        }),
      });

      if (res.ok) {
        const data = (await res.json()) as { mailSent?: boolean };
        // 確認の通知が送れなくても購読は成立しているので、届かないものを案内しない
        msg.textContent = data.mailSent === false
          ? "登録が完了しました！"
          : "登録が完了しました！確認メールをご確認ください。";
        msg.className = "text-sm text-green-400";
        form.reset();
        turnstileToken = "";
        // Retention: 購読完了（継続接点を獲得）
        window.track("subscribe_complete", { type: SUBSCRIBE_TYPE });
      } else {
        const data = (await res.json()) as { error?: string; stage?: string; status?: number; missing?: string };
        // 原因を切り分けられるよう、サーバーが返した段階と上流ステータスを添える（値は数値と短い符号のみ）
        const detail = data.stage ? `（${data.stage} ${data.status ?? "?"}）` : "";
        msg.textContent =
          data.error === "verification_failed" ? "認証に失敗しました。ページを再読み込みしてお試しください。"
          : data.error === "not_configured" ? `現在この機能は準備中です（未設定: ${data.missing ?? "?"}）。しばらくしてからお試しください。`
          : data.error === "invalid_email" ? "メールアドレスの形式をご確認ください。"
          : `登録に失敗しました${detail}。しばらくしてからお試しください。`;
        msg.className = "text-sm text-red-400";
        btn.disabled = false;
        window.track("subscribe_error", { type: SUBSCRIBE_TYPE, reason: data.error ?? "unknown" });
      }
    } catch {
      msg.textContent = "通信エラーが発生しました。";
      msg.className = "text-sm text-red-400";
      btn.disabled = false;
      window.track("subscribe_error", { type: SUBSCRIBE_TYPE, reason: "network" });
    }

    msg.classList.remove("hidden");
    btn.textContent = "登録する";
  });
</script>
