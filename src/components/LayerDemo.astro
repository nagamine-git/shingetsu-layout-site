---
import layoutData from "../data/layout.json";
---

<section id="layer-demo" class="content-section layer-section">
  <div class="page-width">
    <div class="section-heading" data-reveal>
      <p class="section-index" aria-hidden="true">02 / STRUCTURE</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        3層構造でかなを完全収録
      </h2>
      <p class="text-slate-400 max-w-xl mx-auto">
        レイヤーを切り替えて、各キーに割り当てられたかな文字を確認できます。
        ホームポジション（青色）を基点に、指の移動距離を最小限に抑えて入力できます。
      </p>
    </div>

    <!-- Layer tabs -->
    <div class="instrument-panel" data-reveal>
    <div class="instrument-tabs" role="tablist" aria-label="レイヤー切替">
      {layoutData.layers.filter((layer) => layer.id !== 0).map((layer) => (
        <button
          class="layer-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 border border-white/10 text-slate-400 hover:text-white hover:border-white/30"
          data-layer={layer.id}
          role="tab"
          id={`layer-tab-${layer.id}`}
          aria-controls="keyboard-display"
          tabindex={layer.id === 1 ? 0 : -1}
          aria-selected={layer.id === 1 ? "true" : "false"}
        >
          {layer.label}
        </button>
      ))}
    </div>

    <!-- Keyboard grid -->
    <div class="space-y-2" id="keyboard-display" role="tabpanel" aria-labelledby="layer-tab-1" tabindex="0">
      {layoutData.layers[1].keys.map((row, rowIndex) => (
        <div
          class="flex justify-center gap-1.5 layer-row"
          data-row={rowIndex}
        >
          {row.map((char, colIndex) => {
            const isHome = rowIndex === 1 && layoutData.homeRow.includes(colIndex);
            return (
              <div
                class={`key-cell w-12 h-12 sm:w-14 sm:h-14 rounded-lg flex items-center justify-center text-lg font-medium transition-all duration-200 border border-white/10 bg-[var(--color-surface-2)] text-slate-300`}
                data-col={colIndex}
                data-row={rowIndex}
                data-home={isHome ? "true" : undefined}
              >
                {char}
              </div>
            );
          })}
        </div>
      ))}
    </div>

    <p class="text-center text-xs text-slate-500 mt-4">
      青色はホームポジション（人差し指〜小指）を基点とするキー
    </p>
    </div>
  </div>
</section>

<script>
  import layoutJson from "../data/layout.json";

  const layers = layoutJson.layers as Array<{
    id: number;
    label: string;
    keys: string[][];
  }>;
  const homeRow = layoutJson.homeRow as number[];

  function updateDisplay(layerId: number): void {
    const layer = layers.find((l) => l.id === layerId);
    if (!layer) return;
    document.getElementById("keyboard-display")?.setAttribute("aria-labelledby", `layer-tab-${layerId}`);

    const showHome = layerId !== 0;

    document.querySelectorAll<HTMLElement>(".key-cell").forEach((cell) => {
      const row = parseInt(cell.dataset.row ?? "0");
      const col = parseInt(cell.dataset.col ?? "0");
      cell.textContent = layer.keys[row]?.[col] ?? "";

      const isHome = row === 1 && homeRow.includes(col);
      if (isHome) {
        if (showHome) {
          cell.classList.add("border-brand-500/60", "bg-brand-900/40", "text-brand-200");
          cell.classList.remove("border-white/10", "bg-[var(--color-surface-2)]", "text-slate-300");
        } else {
          cell.classList.remove("border-brand-500/60", "bg-brand-900/40", "text-brand-200");
          cell.classList.add("border-white/10", "bg-[var(--color-surface-2)]", "text-slate-300");
        }
      }
    });

    document.querySelectorAll<HTMLButtonElement>(".layer-btn").forEach((btn) => {
      const isActive = parseInt(btn.dataset.layer ?? "0") === layerId;
      btn.setAttribute("aria-selected", String(isActive));
      btn.tabIndex = isActive ? 0 : -1;
      if (isActive) {
        btn.classList.add("bg-brand-600", "text-white", "border-brand-500");
        btn.classList.remove("text-slate-400", "border-white/10");
      } else {
        btn.classList.remove("bg-brand-600", "text-white", "border-brand-500");
        btn.classList.add("text-slate-400", "border-white/10");
      }
    });
  }

  let demoTracked = false;
  document.querySelectorAll<HTMLButtonElement>(".layer-btn").forEach((btn) => {
    btn.addEventListener("keydown", (event): void => {
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".layer-btn"));
      const currentIndex = tabs.indexOf(btn);
      let nextIndex: number;
      if (event.key === "ArrowRight") nextIndex = (currentIndex + 1) % tabs.length;
      else if (event.key === "ArrowLeft") nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
      else if (event.key === "Home") nextIndex = 0;
      else if (event.key === "End") nextIndex = tabs.length - 1;
      else return;
      event.preventDefault();
      tabs[nextIndex].focus();
      tabs[nextIndex].click();
    });
    btn.addEventListener("click", () => {
      const layerId = parseInt(btn.dataset.layer ?? "0");
      updateDisplay(layerId);
      // Activation: デモ操作はセッション内で初回のみ計測（イベント膨張を防ぐ）
      if (!demoTracked) {
        demoTracked = true;
        window.track("demo_interact", { component: "layer_demo", layer: layerId });
      }
    });
  });

  // Initialize first layer as active
  updateDisplay(1);
</script>
