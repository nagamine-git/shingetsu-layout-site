---
const steps = {
  macos: [
    {
      num: 1,
      title: "Karabiner-Elements をインストール",
      code: "brew install --cask karabiner-elements",
      note: "Homebrew がない場合は <a href='https://brew.sh' target='_blank' rel='noopener' class='underline'>brew.sh</a> からインストールしてください。",
    },
    {
      num: 2,
      title: "設定ファイルを取得",
      code: null,
      note: "GitHub リポジトリから <code class='text-green-300 bg-[var(--color-surface)] px-1 rounded text-xs'>shingetsu-karabiner-qwerty.json</code> をダウンロードします。",
    },
    {
      num: 3,
      title: "Karabiner-Elements にインポート",
      code: null,
      note: "Karabiner-Elements の Settings → Complex Modifications から <code class='text-green-300 bg-[var(--color-surface)] px-1 rounded text-xs'>shingetsu-karabiner-qwerty.json</code> をインポートし、新月配列のルールを有効にします。",
    },
  ],
  windows: [
    {
      num: 1,
      title: "Google 日本語入力を用意",
      code: null,
      note: "Windows では <a href='https://www.google.co.jp/ime/' class='underline'>Google 日本語入力</a>用のローマ字テーブルを配布しています。変更前に、現在のローマ字テーブルをエクスポートして保存してください。",
    },
    {
      num: 2,
      title: "Google 日本語入力用テーブルを取得",
      code: null,
      note: "<a href='https://github.com/nagamine-git/shingetsu-layout/blob/main/shingetsu-romantable.txt' class='underline' data-track='install_file_click' data-track-loc='windows'>shingetsu-romantable.txt</a> を開き、GitHub の Download raw file から保存します。hazkey 用 TSV とは別のファイルです。",
    },
    {
      num: 3,
      title: "ローマ字テーブルを変更",
      code: null,
      note: "Google 日本語入力のプロパティでローマ字テーブルの編集画面を開き、保存したファイルをインポートします。入力方法はローマ字入力に設定します。配布テーブルの Windows 実機での入力動作は未検証です。うまく入力できない場合は、保存しておいた元のテーブルに戻してください。",
    },
  ],
  linux: [
    {
      num: 1,
      title: "hazkey を入手",
      code: null,
      note: "hazkey は Linux の Fcitx 5 向け日本語入力です。<a href='https://hazkey.hiira.dev/docs/' class='underline'>hazkey 公式ドキュメント</a>で、お使いの環境のインストール方法をご確認ください。",
    },
    {
      num: 2,
      title: "新月配列の設定を適用",
      code: null,
      note: "リポジトリの <code class='text-green-300 bg-[var(--color-surface)] px-1 rounded text-xs'>shingetsu-ansi-qwerty.tsv</code>（Colemak をお使いの場合は <code class='text-green-300 bg-[var(--color-surface)] px-1 rounded text-xs'>shingetsu-ansi-colemak.tsv</code>）を hazkey のローマ字テーブルとしてインポートし、新月配列を選択します。",
    },
  ],
};
---

<section id="get-started" class="content-section install-section">
  <div class="page-width">
    <div class="section-heading" data-reveal>
      <p class="section-index" aria-hidden="true">05 / GET STARTED</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">導入方法</h2>
      <p class="text-slate-400 max-w-xl mx-auto">
        macOS・Windows・Linux に対応。詳細な手順は
        <a
          href="https://github.com/nagamine-git/shingetsu-layout"
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-400 underline"
          data-track="github_click"
          data-track-loc="get-started-intro"
        >GitHub の README</a> をご参照ください。
      </p>
    </div>

    <!-- OS tabs -->
    <div class="instrument-tabs" id="os-tabs" role="tablist" aria-label="OS を選択">
      <button id="os-tab-macos" aria-controls="os-panel-macos" class="os-tab-btn px-5 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-brand-600 text-white border border-brand-500" data-os="macos" role="tab" aria-selected="true">
        macOS
      </button>
      <button id="os-tab-windows" aria-controls="os-panel-windows" tabindex="-1" class="os-tab-btn px-5 py-2 rounded-lg text-sm font-medium transition-all duration-200 border border-white/10 text-slate-400 hover:text-white" data-os="windows" role="tab" aria-selected="false">
        Windows
      </button>
      <button id="os-tab-linux" aria-controls="os-panel-linux" tabindex="-1" class="os-tab-btn px-5 py-2 rounded-lg text-sm font-medium transition-all duration-200 border border-white/10 text-slate-400 hover:text-white" data-os="linux" role="tab" aria-selected="false">
        Linux
      </button>
    </div>

    <!-- Steps panels -->
    {Object.entries(steps).map(([os, stepsArr]) => (
      <div class="os-panel space-y-4" id={`os-panel-${os}`} aria-labelledby={`os-tab-${os}`} role="tabpanel" tabindex="0" data-os={os}>
        <noscript><h3>{os === "macos" ? "macOS" : os === "windows" ? "Windows" : "Linux"}</h3></noscript>
        {stepsArr.map((step) => (
          <div class="rounded-xl border border-white/10 bg-[var(--color-surface-2)] p-5">
            <div class="flex items-start gap-4">
              <span class="shrink-0 w-7 h-7 rounded-full bg-brand-600 text-white text-xs font-bold flex items-center justify-center">
                {step.num}
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="font-semibold text-white mb-2">{step.title}</h3>
                {step.code && (
                  <div class="relative rounded-lg">
                    <div class="overflow-x-auto rounded-lg">
                      <pre class="bg-[var(--color-surface)] p-3 pr-20 text-xs text-green-300 font-mono leading-relaxed whitespace-pre min-w-0"><code>{step.code}</code></pre>
                    </div>
                    <button
                      type="button"
                      class="copy-cmd-btn absolute top-2 right-2 px-2 py-1 rounded text-xs text-slate-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-colors"
                      data-code={step.code}
                      data-os={os}
                      aria-label="コマンドをコピー"
                    >コピー</button>
                  </div>
                )}
                {step.note && (
                  <p class="text-sm text-slate-400 mt-2" set:html={step.note} />
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    ))}

    <div class="text-center mt-8">
      <a
        href="https://github.com/nagamine-git/shingetsu-layout"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-brand-400 hover:text-brand-300 underline transition-colors"
        data-track="github_click"
        data-track-loc="get-started-cta"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
        </svg>
        GitHub でインストール手順を見る
      </a>
    </div>
  </div>
</section>

<script>
  const osTabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".os-tab-btn"));
  function selectOS(os: string): void {
    for (const tab of osTabs) {
      const isActive = tab.dataset.os === os;
      tab.setAttribute("aria-selected", String(isActive));
      tab.tabIndex = isActive ? 0 : -1;
    }
    document.querySelectorAll<HTMLElement>(".os-panel").forEach((panel): void => {
      panel.hidden = panel.dataset.os !== os;
    });
  }
  selectOS("macos");
  osTabs.forEach((tab): void => {
    tab.addEventListener("click", (): void => {
      const os = tab.dataset.os ?? "macos";
      selectOS(os);
      window.track("os_tab_select", { os });
    });
    tab.addEventListener("keydown", (event): void => {
      const currentIndex = osTabs.indexOf(tab);
      let nextIndex: number;
      if (event.key === "ArrowRight") nextIndex = (currentIndex + 1) % osTabs.length;
      else if (event.key === "ArrowLeft") nextIndex = (currentIndex - 1 + osTabs.length) % osTabs.length;
      else if (event.key === "Home") nextIndex = 0;
      else if (event.key === "End") nextIndex = osTabs.length - 1;
      else return;
      event.preventDefault();
      osTabs[nextIndex].focus();
      osTabs[nextIndex].click();
    });
  });

  // Activation: 導入コマンドのコピーは「実際に試す」最も強いシグナル
  document.querySelectorAll<HTMLButtonElement>(".copy-cmd-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const code = btn.dataset.code ?? "";
      try {
        await navigator.clipboard.writeText(code);
        const original = btn.textContent;
        btn.textContent = "コピー済み";
        setTimeout(() => {
          btn.textContent = original;
        }, 1500);
      } catch {
        // クリップボード非対応環境では表示変更のみスキップ
      }
      window.track("copy_install_cmd", { os: btn.dataset.os });
    });
  });
</script>
