---
import layoutData from "../data/layout.json";
import Eclipse from "./Eclipse.astro";

const kana = [
  ["そ", "こ", "し", "て", "ょ", "つ", "ん", "い", "の", "り"],
  ["は", "か", "★", "と", "た", "く", "う", "☆", "゛゜小", "き"],
  ["す", "け", "に", "な", "さ", "っ", "る", "、", "。", "・"],
];
const extensions = layoutData.layers[2].keys;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-main page-width">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-light" aria-hidden="true"></span>日本語 かな配列</p>
      <h1 id="hero-title" class="hero-title">
        <span class="hero-title-prelude">最小かつ</span>
        <span class="hero-title-emphasis">最高効率<span class="hero-title-particle">の</span></span>
        <span class="hero-title-detail">PCキーボード用<br />かな配列</span>
      </h1>
      <p class="hero-description">
        新月配列は、主要なかな文字を<strong>30 キー</strong>に収め、
        ホームポジションを基点に指の移動を最小限で日本語を入力できるかな配列です。
      </p>
      <div class="hero-actions">
        <a href="#get-started" class="button-primary" data-track="hero_cta_click" data-track-loc="get-started">
          今すぐ導入する<span aria-hidden="true">↗</span>
        </a>
        <a href="#layer-demo" class="button-text" data-track="hero_cta_click" data-track-loc="layer-demo">
          配列を見る<span aria-hidden="true">↓</span>
        </a>
        <a href="#practice" class="button-text" data-track="hero_cta_click" data-track-loc="practice">練習をはじめる<span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-art">
      <Eclipse />
      <button type="button" class="moon-replay" aria-pressed="false" hidden>月を動かす</button>
    </div>
  </div>

  <div class="hero-instrument page-width">
    <div class="hero-instrument-label" aria-hidden="true">
      <span>SHINGETSU LAYOUT</span><span>30 KEYS / 3 LAYERS</span>
    </div>
    <div class="hero-keyboard">
      <svg viewBox="0 0 662 204" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="新月配列キーボード図（中央大：かな Layer 1、右下小：拡張 Layer 2）">
        <defs>
          <linearGradient id="key-material" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#292b2d" />
            <stop offset="1" stop-color="#17191b" />
          </linearGradient>
          <linearGradient id="key-home-material" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#233647" />
            <stop offset="1" stop-color="#16232f" />
          </linearGradient>
        </defs>
        {kana.map((row, rowIndex) => row.map((character, columnIndex) => {
          const positionX = columnIndex * 62 + rowIndex * 20 + 4;
          const positionY = rowIndex * 68 + 4;
          const isHome = rowIndex === 1 && layoutData.homeRow.includes(columnIndex);
          const extension = extensions[rowIndex]?.[columnIndex] ?? "";
          return (
            <g class:list={["hero-key", { "hero-key-home": isHome }]}>
              <rect x={positionX} y={positionY + 3} width="56" height="60" rx="7" fill="#08090a" />
              <rect class="hero-key-face" x={positionX} y={positionY} width="56" height="58" rx="7" fill={isHome ? "url(#key-home-material)" : "url(#key-material)"} stroke={isHome ? "#6386a1" : "#484a4d"} stroke-width=".7" />
              <text x={positionX + 28} y={character.length > 1 ? positionY + 28 : positionY + 34} text-anchor="middle" fill={isHome ? "#b8d8f4" : "#e3ded5"} font-size={character.length > 1 ? "11" : "19"} font-weight="500">{character}</text>
              {extension && <text x={positionX + 51} y={positionY + 51} text-anchor="end" fill="#a1a3a7" font-size="12">{extension}</text>}
              {isHome && <path d={`M${positionX + 22} ${positionY + 54}h12`} stroke="#8bb6d8" stroke-width="1.5" />}
            </g>
          );
        }))}
      </svg>
    </div>
    <p class="hero-legend">大：かな（Layer 1）　右下小：拡張（Layer 2）　青：ホームポジション基点キー</p>
    <a href="#features" class="hero-scroll"><span>スクロール</span><span aria-hidden="true">↓</span></a>
  </div>
</section>

<script>
  const lunarStage = document.querySelector<HTMLElement>(".hero-art");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const replayButton = document.querySelector<HTMLButtonElement>(".moon-replay");
  const phaseShadow = document.querySelector<SVGElement>(".eclipse-phase-shadow");
  const moonAnimations: Animation[] = [];
  let manualMotion = false;
  let userPaused = false;
  let moonVisible = false;
  let ready = false;
  let completed = false;

  function updateMoonMotion(): void {
    const permitted = !reducedMotion.matches || manualMotion;
    const playing = ready && permitted && !userPaused && moonVisible && !document.hidden && !completed;
    if (!completed) {
      for (const animation of moonAnimations) {
        if (playing) animation.play();
        else animation.pause();
      }
    }
    if (replayButton) {
      replayButton.textContent = completed ? "↻ もう一度見る" : ready && permitted && !userPaused ? "Ⅱ 動きを止める" : "▷ 月を動かす";
      replayButton.setAttribute("aria-pressed", String(ready && permitted && !userPaused && !completed));
    }
  }

  if (replayButton && phaseShadow && typeof phaseShadow.animate === "function") {
    const phase = phaseShadow.animate(
      [
        { transform: "translateX(-100px)", offset: 0, easing: "cubic-bezier(.4,0,.2,1)" },
        { transform: "translateX(0)", offset: .8, easing: "linear" },
        { transform: "translateX(0)", offset: 1 },
      ],
      { duration: 8000, fill: "forwards" },
    );
    phase.pause();
    phase.currentTime = 0;
    moonAnimations.push(phase);
    const moon = document.querySelector<HTMLElement>(".eclipse");
    if (moon) {
      const camera = moon.animate(
        [
          { filter: "blur(0px)", transform: "scale(1)", offset: 0, easing: "ease-in-out" },
          { filter: "blur(2.4px)", transform: "scale(1.015)", offset: .12, easing: "ease-in-out" },
          { filter: "blur(.6px)", transform: "scale(1.03)", offset: .35, easing: "ease-in-out" },
          { filter: "blur(0px)", transform: "scale(1)", offset: .8 },
          { filter: "blur(0px)", transform: "scale(1)", offset: 1 },
        ],
        { duration: 8000, fill: "forwards" },
      );
      camera.pause();
      camera.currentTime = 0;
      moonAnimations.push(camera);
    }
    const film = document.querySelector<SVGElement>(".eclipse-film");
    if (film) {
      const grain = film.animate(
        [
          { opacity: .035, transform: "translate(0, 0)", offset: 0 },
          { opacity: .12, transform: "translate(-1px, 1px)", offset: .15 },
          { opacity: .055, transform: "translate(1px, -1px)", offset: .35 },
          { opacity: .1, transform: "translate(-1px, -1px)", offset: .55 },
          { opacity: .035, transform: "translate(0, 0)", offset: .8 },
          { opacity: .035, transform: "translate(0, 0)", offset: 1 },
        ],
        { duration: 8000, fill: "forwards" },
      );
      grain.pause();
      grain.currentTime = 0;
      moonAnimations.push(grain);
    }
    const halo = document.querySelector<HTMLElement>(".eclipse-halo");
    if (halo) {
      const light = halo.animate(
        [{ opacity: 0, offset: 0 }, { opacity: 0, offset: .8, easing: "ease-out" }, { opacity: 1, offset: 1 }],
        { duration: 8000, fill: "forwards" },
      );
      light.pause();
      light.currentTime = 0;
      moonAnimations.push(light);
    }
    phase.onfinish = (): void => {
      completed = true;
      updateMoonMotion();
    };
    replayButton.hidden = false;
    replayButton.addEventListener("click", (): void => {
      if (completed) {
        completed = false;
        for (const animation of moonAnimations) animation.currentTime = 0;
        manualMotion = true;
        userPaused = false;
      } else if (ready && (!reducedMotion.matches || manualMotion) && !userPaused) userPaused = true;
      else { manualMotion = true; userPaused = false; }
      ready = true;
      updateMoonMotion();
    });
    if (lunarStage && "IntersectionObserver" in window) {
      new IntersectionObserver((entries): void => {
        moonVisible = entries.some((entry): boolean => entry.isIntersecting);
        updateMoonMotion();
      }, { threshold: .15 }).observe(lunarStage);
    } else { moonVisible = true; }
    document.addEventListener("visibilitychange", updateMoonMotion);
    const scheduleStart = (): void => {
      setTimeout((): void => { ready = true; updateMoonMotion(); }, 1200);
    };
    if (document.readyState === "complete") scheduleStart();
    else window.addEventListener("load", scheduleStart, { once: true });
    updateMoonMotion();
  }
  reducedMotion.addEventListener("change", (): void => {
    manualMotion = false;
    updateMoonMotion();
  });
</script>
