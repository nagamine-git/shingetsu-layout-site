---
import layoutData from "../data/layout.json";
import Eclipse from "./Eclipse.astro";

const kana = [
  ["そ", "こ", "し", "て", "ょ", "つ", "ん", "い", "の", "り"],
  ["は", "か", "★", "と", "た", "く", "う", "☆", "゛゜小", "き"],
  ["す", "け", "に", "な", "さ", "っ", "る", "、", "。", "・"],
];
const extensions = layoutData.layers[2].keys;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="hero-main page-width">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-light" aria-hidden="true"></span>日本語 かな配列</p>
      <h1 id="hero-title" class="hero-title">
        <span class="hero-title-prelude">最小かつ</span>
        <span class="hero-title-emphasis">最高効率<span class="hero-title-particle">の</span></span>
        <span class="hero-title-detail">PCキーボード用<br />かな配列</span>
      </h1>
      <p class="hero-description">
        新月配列は、主要なかな文字を<strong>30 キー</strong>に収め、
        ホームポジションを基点に指の移動を最小限で日本語を入力できるかな配列です。
      </p>
      <div class="hero-actions">
        <a href="#get-started" class="button-primary" data-track="hero_cta_click" data-track-loc="get-started">
          今すぐ導入する<span aria-hidden="true">↗</span>
        </a>
        <a href="#layer-demo" class="button-text" data-track="hero_cta_click" data-track-loc="layer-demo">
          配列を見る<span aria-hidden="true">↓</span>
        </a>
        <a href="#practice" class="button-text" data-track="hero_cta_click" data-track-loc="practice">練習をはじめる<span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-art">
      <Eclipse />
      <p class="hero-art-signature" aria-hidden="true">SHINGETSU <span>新月</span></p>
    </div>
  </div>

  <div class="hero-instrument page-width">
    <div class="hero-instrument-label" aria-hidden="true">
      <span>SHINGETSU LAYOUT</span><span>30 KEYS / 3 LAYERS</span>
    </div>
    <div class="hero-keyboard">
      <svg viewBox="0 0 662 204" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="新月配列キーボード図（中央大：かな Layer 1、右下小：拡張 Layer 2）">
        <defs>
          <linearGradient id="key-material" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#292b2d" />
            <stop offset="1" stop-color="#17191b" />
          </linearGradient>
          <linearGradient id="key-home-material" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#233647" />
            <stop offset="1" stop-color="#16232f" />
          </linearGradient>
        </defs>
        {kana.map((row, rowIndex) => row.map((character, columnIndex) => {
          const positionX = columnIndex * 62 + rowIndex * 20 + 4;
          const positionY = rowIndex * 68 + 4;
          const isHome = rowIndex === 1 && layoutData.homeRow.includes(columnIndex);
          const extension = extensions[rowIndex]?.[columnIndex] ?? "";
          return (
            <g class:list={["hero-key", { "hero-key-home": isHome }]}>
              <rect x={positionX} y={positionY + 3} width="56" height="60" rx="7" fill="#08090a" />
              <rect class="hero-key-face" x={positionX} y={positionY} width="56" height="58" rx="7" fill={isHome ? "url(#key-home-material)" : "url(#key-material)"} stroke={isHome ? "#6386a1" : "#484a4d"} stroke-width=".7" />
              <text x={positionX + 28} y={character.length > 1 ? positionY + 28 : positionY + 34} text-anchor="middle" fill={isHome ? "#b8d8f4" : "#e3ded5"} font-size={character.length > 1 ? "11" : "19"} font-weight="500">{character}</text>
              {extension && <text x={positionX + 51} y={positionY + 51} text-anchor="end" fill="#a1a3a7" font-size="12">{extension}</text>}
              {isHome && <path d={`M${positionX + 22} ${positionY + 54}h12`} stroke="#8bb6d8" stroke-width="1.5" />}
            </g>
          );
        }))}
      </svg>
    </div>
    <p class="hero-legend">大：かな（Layer 1）　右下小：拡張（Layer 2）　青：ホームポジション基点キー</p>
    <a href="#features" class="hero-scroll"><span>スクロール</span><span aria-hidden="true">↓</span></a>
  </div>
</section>

<script>
  const lunarSurface = document.querySelector<HTMLElement>(".eclipse");
  const lunarStage = document.querySelector<HTMLElement>(".hero-art");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const precisePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  let lunarAnimation: Animation | undefined;
  let pendingFrame = 0;

  function moveMoon(horizontal: number, vertical: number): void {
    if (!lunarSurface || reducedMotion.matches || !precisePointer.matches) return;
    const currentTransform = getComputedStyle(lunarSurface).transform;
    lunarAnimation?.cancel();
    lunarAnimation = lunarSurface.animate(
      [
        { transform: currentTransform },
        { transform: `perspective(1100px) rotateX(${vertical * -4}deg) rotateY(${horizontal * 4}deg) translate(${horizontal * 7}px, ${vertical * 5}px)` },
      ],
      { duration: 650, easing: "cubic-bezier(.22,1,.36,1)", fill: "forwards" },
    );
  }

  lunarStage?.addEventListener("pointermove", (event): void => {
    if (pendingFrame || reducedMotion.matches || !precisePointer.matches) return;
    pendingFrame = requestAnimationFrame((): void => {
      pendingFrame = 0;
      const bounds = lunarStage.getBoundingClientRect();
      moveMoon((event.clientX - bounds.left) / bounds.width - .5, (event.clientY - bounds.top) / bounds.height - .5);
    });
  });
  lunarStage?.addEventListener("pointerleave", (): void => {
    cancelAnimationFrame(pendingFrame);
    pendingFrame = 0;
    moveMoon(0, 0);
  });
  reducedMotion.addEventListener("change", (): void => {
    if (reducedMotion.matches) {
      cancelAnimationFrame(pendingFrame);
      pendingFrame = 0;
      lunarAnimation?.cancel();
    }
  });
</script>
