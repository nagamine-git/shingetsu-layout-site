---
import layout from "../data/layout.json";
import { curriculum, trainingCorpus } from "../data/trainingCorpus";
import { trainingParagraphs } from "../data/trainingParagraphs";
import KeyboardGeometry from "./KeyboardGeometry.astro";
// 通常は「練習する」（自動メニュー）と「測る」の 2 択。手動メニューは設定内に畳む。
// 列ごとの担当指（左小指 … 右小指）。キーの色分けに使う
const fingers = ["lp", "lr", "lm", "li", "li", "ri", "ri", "rm", "rr", "rp"];
const modes = [
  { id: "learn", number: "01", title: "習得", sub: "ことばで覚える" },
  { id: "review", number: "02", title: "復習", sub: "ヒントなしで想起" },
  { id: "drill", number: "03", title: "弱点ドリル", sub: "遅い指を、狙い撃つ" },
  { id: "speed", number: "04", title: "高速化", sub: "60秒 / 疾走15秒" },
  { id: "focus", number: "05", title: "集中画面", sub: "短く打って、振り返る" },
];
---

<div id="training-lab" class="training-lab" hidden>
  <header id="lab-focus-toolbar" class="lab-focus-toolbar" hidden>
    <button id="lab-focus-exit" type="button" class="lab-secondary">← モード選択</button>
    <h1>新月タイピング <span>集中</span></h1>
    <button id="lab-focus-settings" type="button" class="lab-secondary" aria-expanded="false" aria-controls="lab-settings">設定</button>
  </header>
  <div class="lab-launch" role="group" aria-label="練習の始め方">
    <button id="lab-auto" type="button" class="lab-launch-main" aria-pressed="true"><strong>練習する</strong><small id="lab-auto-hint">記録から今日のメニューを自動で決めます</small></button>
    <button id="lab-measure" type="button" class="lab-launch-side" data-mode="benchmark" aria-pressed="false"><strong>測る</strong><small>60秒をくり返す · Enterで次の一本</small></button>
  </div>
  <details id="lab-manual" class="lab-manual">
    <summary>メニューを自分で選ぶ <span id="lab-manual-label" class="lab-muted"></span></summary>
    <nav class="lab-modes" aria-label="トレーニングの種類">
      {modes.map((mode) => <button type="button" data-mode={mode.id} aria-pressed="false">
        <span class="lab-mode-number">{mode.number}</span><span><strong>{mode.title}</strong><small>{mode.sub}</small></span>
      </button>)}
    </nav>
    <p class="lab-muted">自動は、段階が残る人には習得、復習期限があれば想起、全段階が安定したら弱点ドリルと高速化（60秒と疾走15秒の交互）を選びます。「測る」は、その日の最初の1本だけ固定文、以降は直近に打っていない文で60秒をくり返します（弱点を含む文を3割だけ混ぜます）。</p>
  </details>
  <div class="lab-soundbar">
    <details id="lab-sound-panel" class="lab-sound-panel">
      <summary>音のアトリエ <span id="lab-sound-label">OFF</span></summary>
      <div class="lab-sound-options">
        <p class="lab-muted">音は任意。無音でもすべての練習ができます。小さな音量からどうぞ。</p>
        <label for="lab-bgm">BGM</label>
        <select id="lab-bgm"><option value="off">なし</option><option value="eclipse">黒月 / ECLIPSE · 壮大なシンセ</option><option value="still">静月 / STILL · アンビエント</option><option value="orbit">月行 / ORBIT · 電子パルス</option></select>
        <label for="lab-bgm-volume">BGM音量 <output id="lab-bgm-value" for="lab-bgm-volume">20%</output></label>
        <input id="lab-bgm-volume" type="range" min="0" max="100" step="1" value="20" />
        <label for="lab-se">打鍵音</label>
        <select id="lab-se"><option value="off">なし</option><option value="felt">FELT · 柔らかなコトコト</option><option value="tactile">TACTILE · 乾いたカチカチ</option><option value="glass">GLASS · 透明な電子音</option></select>
        <label for="lab-se-volume">打鍵音量 <output id="lab-se-value" for="lab-se-volume">30%</output></label>
        <input id="lab-se-volume" type="range" min="0" max="100" step="1" value="30" />
        <button id="lab-sound-preview" class="lab-secondary" type="button">選んだ音を3秒試聴</button>
        <p class="lab-muted">すべて独自の合成音。BGMは練習中に再生し、Escでも曲の進行はリセットしません。IME実践の打鍵音は確定入力ごとに鳴ります。</p>
      </div>
    </details>
    <button id="lab-sound-toggle" type="button" class="lab-secondary" aria-pressed="false">音を有効にする</button>
    <span id="lab-sound-status" class="lab-muted" role="status"></span>
  </div>
  <div class="lab-workspace">
    <aside id="lab-settings" class="lab-plan" aria-label="練習プラン">
      <p class="lab-eyebrow">YOUR NEXT STEP</p>
      <h2 id="lab-plan-title">ことばの入口</h2>
      <p id="lab-plan-description">まずは意味のある短いことばから。</p>
      <div class="lab-controls">
        <label for="lab-method">入力方法</label>
        <select id="lab-method"><option value="keyboard">PCキーボード</option><option value="touch">画面タップ · 配置を覚える</option><option value="ime">導入済みIME · 漢字変換まで実際に</option></select>
        <div id="lab-stage-control"><label for="lab-level">練習する段階</label><select id="lab-level"><option value="auto">自動 · 記録から選ぶ</option>{curriculum.map((stage, index) => <option value={index}>{index + 1}. {stage.name}</option>)}</select></div>
        <div id="lab-duration-control" hidden><label for="lab-duration">テスト時間</label><select id="lab-duration"><option value="15">15秒 · 疾走（自己ベスト+8%を狙う）</option><option value="30">30秒 · 短く集中</option><option value="60" selected>60秒 · 標準</option><option value="120">120秒 · 持続力</option></select></div>
        <div id="lab-material-control" hidden><label for="lab-material">練習する文章</label><select id="lab-material"><option value="short">語句・短文</option><option value="paragraph">まとまった文章 · 4文でひとつの話</option></select></div>
        <div id="lab-hints-control"><label for="lab-hints">打鍵ガイド</label><select id="lab-hints"><option value="auto">自動 · 覚えたら隠す</option><option value="on">常に表示</option><option value="off">表示しない</option></select></div>
        <KeyboardGeometry id="lab-geometry" />
      </div>
      <div class="lab-daily">
        <div><span>今日の積み重ね</span><strong id="lab-today">0 / 10 分</strong></div>
        <progress id="lab-daily-progress" max="600" value="0" aria-label="今日の練習時間"></progress>
        <p>10分は目安。短く分けて、無理のない範囲で。</p>
      </div>
      <div class="lab-focus-card"><span class="lab-eyebrow">FOCUS</span><p id="lab-focus">速さより、迷わず正確に。</p><p id="lab-due" class="lab-muted"></p></div>
      <a class="lab-guide-link" href="#lab-how">使い方・入力設定 ↗</a>
    </aside>
    <section class="lab-console" aria-label="タイピングエリア">
      <div class="lab-console-top"><span id="lab-session-label">適応レッスン</span><span id="lab-clock">READY</span></div>
      <progress id="lab-progress" max="100" value="0" aria-label="この練習の進み具合"></progress>
      <p id="lab-input-help" class="lab-input-help">IMEとOS側の新月配列リマップはオフに。英数・QWERTY状態で、D/Kも順番に押します。</p>
      <div class="lab-actions">
        <button id="lab-start" type="button" class="button-primary">練習をはじめる <span aria-hidden="true">↗</span></button>
        <button id="lab-pause" type="button" class="lab-secondary" hidden>一時停止</button>
        <button id="lab-abandon" type="button" class="lab-secondary" hidden>終了する</button>
        <button id="lab-show-hint" type="button" class="lab-secondary">ヒントを見る</button>
        <span id="lab-focus-shortcut" class="lab-muted" hidden><kbd>Esc</kbd> で最初から</span>
        <a href="#lab-settings" class="lab-mobile-settings">練習設定 ↓</a>
      </div>
      <div class="lab-live" aria-label="現在の成績">
        <div><strong id="lab-cpm">—</strong><span id="lab-cpm-label">かな / 分</span></div>
        <div><strong id="lab-accuracy">—</strong><span id="lab-accuracy-label">打鍵正確率</span></div>
        <div><strong id="lab-errors">0</strong><span id="lab-errors-label">ミス打鍵</span></div>
        <div class="lab-pace"><span id="lab-pace">正確さから、速さへ。</span></div>
      </div>
      <div id="lab-stage" class="lab-stage" tabindex="0" role="group" aria-label="新月配列の打鍵入力エリア" aria-describedby="lab-input-help lab-status">
        <div class="lab-passage-label"><span id="lab-topic">暮らしのことば</span><span id="lab-counter"></span></div>
        <p id="lab-meaning" class="lab-meaning"></p>
        <p id="lab-prompt" class="lab-prompt" aria-label="入力する読み"></p>
        <div id="lab-key-guide" class="lab-key-guide" aria-label="次の打鍵のヒント"></div>
        <p id="lab-next" class="lab-next"></p>
      </div>
      <div id="lab-ime-area" class="lab-ime-area" hidden>
        <label for="lab-ime-input">上の文章を、漢字変換して入力</label>
        <textarea id="lab-ime-input" rows="3" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="lab-input-help" placeholder="開始後、ここに入力してください" disabled></textarea>
        <p class="lab-muted">句読点まで一致すると次の文へ。誤字はBackspaceで修正。予測変換・貼り付けは使わずに。</p>
      </div>
      <p id="lab-status" class="lab-status" role="status" aria-live="polite">開始すると、最初の打鍵から計測します。</p>
      <div id="lab-keyboard" class="lab-keyboard" aria-label="新月配列のキーガイドとタップ入力">
        {layout.layers[0].keys.map((row, rowIndex) => <div class="lab-key-row keyboard-row" data-row={rowIndex}>
          {row.map((key, columnIndex) => <button type="button" class="lab-key" data-key={key} data-finger={fingers[columnIndex]} aria-label={`${key.toUpperCase()}、${layout.layers[1].keys[rowIndex][columnIndex]}`}>
            <span>{key.toUpperCase()}</span><strong>{layout.layers[1].keys[rowIndex][columnIndex]}</strong>
          </button>)}
          {rowIndex === 0 && <button type="button" class="lab-key" data-key="[" data-finger="rp" aria-label="左角括弧キー、かぎ括弧開き"><span>[</span><strong>「</strong></button>}
          {rowIndex === 0 && <button type="button" class="lab-key" data-key="]" data-finger="rp" aria-label="右角括弧キー、かぎ括弧閉じ"><span>]</span><strong>」</strong></button>}
        </div>)}
        <div id="lab-punctuation" class="lab-punctuation"><span class="lab-finger-legend" aria-hidden="true"><i data-finger="lp"></i>小指 <i data-finger="lr"></i>薬指 <i data-finger="lm"></i>中指 <i data-finger="li"></i>人差し指</span><span>D＝★前置 / K＝☆前置 / L＝濁点</span></div>
      </div>
      <div id="lab-rest" class="lab-rest" hidden><strong>手を離して、一息。</strong><p id="lab-rest-text">20秒を目安に、遠くを見たり、肩の力を抜いたり。</p><button id="lab-rest-skip" type="button" class="lab-secondary">休憩を終える</button></div>
    </section>
  </div>
  <section id="lab-result" class="lab-result" aria-labelledby="lab-result-title" aria-describedby="lab-result-summary" tabindex="-1" hidden>
    <div class="lab-result-heading"><div><p class="lab-eyebrow">SESSION COMPLETE</p><h2 id="lab-result-title">一歩、指に馴染んだ。</h2></div><p id="lab-result-tag"></p></div>
    <p id="lab-result-summary"></p>
    <p id="lab-result-growth" class="lab-result-growth"></p>
    <div id="lab-measure-bar" class="lab-measure-bar" hidden><p id="lab-measure-next" class="lab-measure-next"></p><button id="lab-measure-go" type="button" class="button-primary" aria-keyshortcuts="Enter Space">次の一本 <kbd>Enter ↵</kbd></button></div>
    <p id="lab-rate" class="lab-rate" hidden></p>
    <figure id="lab-loop-growth" class="lab-loop-growth" hidden><figcaption id="lab-loop-growth-title">成長曲線</figcaption><svg id="lab-loop-chart" viewBox="0 0 640 150" role="img" aria-label="同じ条件の入力速度の推移"></svg><p id="lab-loop-growth-note" class="lab-muted"></p></figure>
    <p id="lab-result-milestone" class="lab-result-milestone" hidden></p>
    <div class="lab-result-grid">
      <div><h3>このセッションのペース</h3><svg id="lab-chart" viewBox="0 0 640 170" role="img" aria-label="経過秒数と累積平均入力速度"><path class="lab-chart-grid" d="M35 15V140H620 M35 78H620"/><path id="lab-chart-line" d=""/><text id="lab-chart-max" x="2" y="20"></text><text x="16" y="143">0</text><text x="35" y="164">0秒</text><text id="lab-chart-end" x="555" y="164"></text></svg><p id="lab-chart-note" class="lab-muted"></p></div>
      <div class="lab-next-step"><span class="lab-eyebrow">NEXT / 次の一手</span><h3 id="lab-advice-title"></h3><p id="lab-advice"></p><button id="lab-target-review" type="button" class="lab-secondary">この弱点を文で復習 →</button></div>
    </div>
    <div id="lab-drill-report" class="lab-drill-report" hidden><h3>狙った弱点の変化 · 選定時の基準値 → この回</h3><ul id="lab-drill-list"></ul><p class="lab-muted">かなは打鍵あたりの中央値、2打鍵は間隔。ミス・ヒントありの試行は除外。1回で決めず、数日空けて同じ弱点が残るかを見ます。</p></div>
    <details class="lab-analysis-wrap"><summary>迷いやすい文字・遅い2打鍵を見る</summary><div class="lab-analysis-grid"><div><h3>迷いやすい文字</h3><ul id="lab-weak-list"></ul></div><div><h3>遅い2打鍵 · この入力方法の累積</h3><ul id="lab-pair-list"></ul></div></div></details>
    <div id="lab-focus-result" class="lab-focus-result" hidden>
      <div class="lab-focus-metrics"><div><strong id="lab-focus-cpm"></strong><span>かな / 分</span></div><div><strong id="lab-focus-accuracy"></strong><span>打鍵正確率</span></div></div>
      <p id="lab-focus-summary" class="lab-muted"></p>
      <p id="lab-focus-tip"></p>
      <button id="lab-retry" type="button" class="button-primary" aria-keyshortcuts="Enter">もう一度 <kbd>Enter ↵</kbd></button>
      <p class="lab-muted">Enterで次の課題へ。Escなら同じ課題を最初から。自動では再開しません。休憩はいつでも。</p>
      <p id="lab-focus-storage" class="lab-muted"></p>
    </div>
  </section>
  <details id="lab-records-wrap" class="lab-records-wrap"><summary><span>記録と成長</span><span class="lab-muted">成長グラフ · 今週の積み重ね · 習熟マップ · 速度マップ · 履歴 · バックアップ</span></summary>
  <section class="lab-records" aria-labelledby="lab-records-title">
    <div class="lab-records-heading"><div><p class="lab-eyebrow">YOUR PROGRESS</p><h2 id="lab-records-title">昨日より、自然に。</h2></div><p id="lab-history-summary">記録はこの端末だけに。</p></div>
    <div class="lab-growth">
      <div class="lab-growth-heading"><div><p class="lab-eyebrow">YOUR OWN ORBIT</p><h3>一回の最高より、いつもの成長。</h3></div><div class="lab-growth-filters"><label for="lab-growth-condition">比較する条件</label><select id="lab-growth-condition"></select><label for="lab-growth-period">期間</label><select id="lab-growth-period"><option value="7">7日</option><option value="30" selected>30日</option><option value="0">保存済みすべて</option></select></div></div>
      <p id="lab-growth-summary" class="lab-growth-summary" role="status"></p>
      <div class="lab-growth-charts">
        <div><h4 id="lab-growth-speed-label">入力速度 · かな / 分</h4><svg id="lab-growth-speed" viewBox="0 0 640 180" role="img" aria-labelledby="lab-growth-speed-label" aria-describedby="lab-growth-summary"></svg></div>
        <div><h4 id="lab-growth-accuracy-label">正確率 · %</h4><svg id="lab-growth-accuracy" viewBox="0 0 640 180" role="img" aria-labelledby="lab-growth-accuracy-label" aria-describedby="lab-growth-summary"></svg></div>
      </div>
      <p class="lab-muted">● 各回の記録　◇ 比較対象外　線：比較可能な直近5回の速度中央値。低正確率・ヒントあり・中断も表示します。音の条件は混在します。定点測定では毎回同じ音設定をおすすめします。</p>
      <details class="lab-growth-data"><summary>グラフの数値を表で読む</summary><div class="lab-table-scroll"><table class="lab-history-table"><caption>選択条件の保存済み記録</caption><thead><tr><th scope="col">日時</th><th scope="col">速度</th><th scope="col">正確率 / 一致率</th><th scope="col">直近5回中央値</th><th scope="col">比較</th></tr></thead><tbody id="lab-growth-table"></tbody></table></div></details>
    </div>
    <div class="lab-journey">
      <section aria-labelledby="lab-week-title"><p class="lab-eyebrow">A LITTLE, OFTEN</p><h3 id="lab-week-title">今週の積み重ね</h3><p id="lab-week-count" class="lab-week-count"></p><label for="lab-week-goal">週の練習目標</label><select id="lab-week-goal"><option value="2">週2日</option><option value="3" selected>週3日</option><option value="5">週5日</option><option value="7">週7日</option></select><progress id="lab-week-progress" value="0" max="3" aria-label="今週の練習日数"></progress><p class="lab-muted">月曜始まり。15秒・10文字以上の完了記録を集計。休んでも罰則はありません。</p></section>
      <section aria-labelledby="lab-quest-title"><p class="lab-eyebrow">NEXT SMALL STEP</p><h3 id="lab-quest-title">今日の小さな課題</h3><p id="lab-quest-text"></p><button id="lab-quest-start" type="button" class="lab-secondary">復習を始める →</button><p class="lab-muted">無意味な連打ではなく、ことばの中で思い出す練習を。</p></section>
    </div>
    <h3 class="lab-milestones-heading">積み重ねのしるし</h3><ul id="lab-milestones" class="lab-milestones"></ul>
    <p class="lab-muted">しるし・今週の集計は、この端末に保存された最新180件から計算します。技能の認定や永久保存の実績ではありません。</p>
    <div class="lab-skill-heading"><h3>かなの習熟マップ</h3><p>○ 安定 · ◐ 練習中 · — 未練習</p></div>
    <div id="lab-skill-map" class="lab-skill-map"></div>
    <p class="lab-muted">「安定」は、自力での試行・誤打が直近6回以上あり、正答率95%以上・打鍵あたり中央値1.5秒以内。ガイドに頼った正答は判定に含めません。自動段階は対象文字の80%が安定すると進みます。医学的な判定ではなく、本ツール独自の目安です。</p>
    <div class="lab-skill-heading"><h3>指の速度マップ</h3><p>そのキーへ移る2打鍵の平均間隔。本人の中で相対評価</p></div>
    <div id="lab-heat-map" class="lab-heat-map" aria-label="キー別の打鍵間隔"></div>
    <p id="lab-heat-note" class="lab-muted">濃いほど遅い。3標本未満のキーは灰色。ここで濃いキーへの遷移が、弱点ドリルの候補になります。</p>
    <div class="lab-table-scroll"><table class="lab-history-table"><caption>直近8回の記録 · 条件の異なる速度は比較しません</caption><thead><tr><th scope="col">日時</th><th scope="col">内容・入力</th><th scope="col">速度</th><th scope="col">正確率 / 一致率</th><th scope="col">条件</th></tr></thead><tbody id="lab-history"></tbody></table></div>
    <details class="lab-storage"><summary>保存・バックアップ・プライバシー</summary><p id="lab-storage-message">成績はこのブラウザのlocalStorageに保存します。アカウント・同期はありません。</p><p>入力文や打鍵ログをサーバーへ送信しません。バックアップには文字別の集計と練習結果を含みます。サイト共通のアクセス解析は利用しています。</p><div class="lab-storage-actions"><button id="lab-export" type="button" class="lab-secondary">記録を書き出す</button><label class="lab-secondary" for="lab-import">記録を読み込む</label><input id="lab-import" type="file" accept="application/json,.json"/><button id="lab-reset" type="button" class="lab-secondary">この練習の記録を削除</button></div><p id="lab-data-status" role="status"></p></details>
  </section>
  </details>
</div>
<noscript><p class="lab-nojs">タイピング練習にはJavaScriptが必要です。以下の使い方・学習方針と<a href="/#layers">配列図</a>はそのまま読めます。</p></noscript>
<details id="lab-how" class="lab-explainer-wrap"><summary><span>使い方と根拠</span><span class="lab-muted">入力設定 · 自動メニューの決め方 · 数字の読み方 · 参考研究</span></summary>
<section class="lab-explainer" aria-labelledby="lab-how-title">
  <p class="lab-eyebrow">PRACTICE WITH INTENTION</p><h2 id="lab-how-title">ただ打つ、で終わらない。</h2>
  <div class="lab-principles">
    <article><span>01 / ACQUIRE</span><h3>意味から、指へ。</h3><p>{trainingCorpus.length}件の書き下ろし語・短文を使います。キー位置を覚え、短い文へ。文字を無作為に並べた問題は出しません。ガイドは、同じ文字を3回経験すると自動で隠れ、迷ったときだけ戻ります。</p></article>
    <article><span>02 / RETAIN</span><h3>忘れる前に、別の文で。</h3><p>間違い・迷い・復習期限をもとに出題を調整。できた文字も混ぜます。復習の間隔は1・3・7・14日を目安に広げます。結果直後の復習だけでなく、日を空けて思い出せるかを確かめます。</p></article>
    <article><span>03 / ACCELERATE</span><h3>速さを、分解する。</h3><p>30・60・120秒で自然な文を連続入力。ミスした文字と遅い2打鍵を分析し、その組み合わせを含む別の文章へ戻ります。定点測定は学習用とは別の固定文・60秒・ヒントなしです。</p></article>
    <article><span>04 / SHARPEN</span><h3>頭打ちを、崩す。</h3><p>覚えたあとの伸び悩みには二つの手。<strong>弱点ドリル</strong>は、本人の中央値より遅いかな・2打鍵を自動で選び、それを含む文を7割、得意な文を3割混ぜて45秒。<strong>疾走</strong>は高速化モードの15秒で、自己ベスト+8%を狙って上限を押し上げ、そのあと60秒で正確さを取り戻します。</p></article>
  </div>
  <details open><summary>最初に：PC・スマートフォン・導入済みIMEの使い分け</summary><div>
    <p><strong>長音「ー」：</strong>PC練習では新月配列のD→Pに加えて、ハイフンキー・テンキーのマイナスでも入力できます。「- － − ‐ ‑ ‒ – — ― ﹣ ｰ ー」を長音の位置だけで受け付けます。Dを押した後はPで完了してください。IME実践でも、お題の「ー」に対して同じ表記を許容します。変換中の未確定文字は採点しません。入力規則が変わったため、PC・IMEの自己ベストは旧記録と分けて比較します。過去の履歴は残ります。</p>
    <p><strong>キーボードの形：</strong>設定で「一般的な配列（斜め）・格子配列・左右分割（5列ずつ）」を選べます。表示の形だけが変わり、キーの割り当てと採点は同じです。選択はこのブラウザに保存し、トップページの配列図・体験・練習にも共通で反映します。集中モードでは「設定」から変更できます。セッション中は誤操作を避けるため変更できません。</p>
    <p><strong>まとまった文章：</strong>集中・高速化モードの設定にある「練習する文章」から選べます。仕事の連絡や日々の風景など、4文でひとつの話になる書き下ろし{trainingParagraphs.length}本を収録。原文全体を読みながら、かなの入力位置に合わせて表示欄が追従します。文章の途中でも時間が来たら終了し、それまでに打ち終えたかなを採点。短文とは自己ベストを分けます。<a href="/practice/?mode=focus&amp;material=paragraph">まとまった文章で集中する →</a></p>
    <p><strong>練習する（自動）と測る：</strong>「練習する」は記録から次の 1 ブロックを決めます。段階が残る人は習得（復習期限が 3 文字以上たまれば 1 ブロック復習を挟む）、全段階に入ったら復習期限 → 弱点ドリル → 高速化の順。高速化は 60 秒で正確率 96% 以上なら次は疾走 15 秒、疾走の後は必ず 60 秒で定着、と交互にします。同じ種類は連続させません。理由はプラン欄に一文で表示します。「測る」は学習用とは別の固定文・60 秒・ヒントなしで、訓練と測定を分けます。自分で選びたいときは「メニューを自分で選ぶ」から。</p>
    <p><strong>習得・復習・高速化・定点測定・集中：</strong>配列のインストール不要。PCはIMEをオフ、OSのキー変換もオフの英数QWERTY状態にしてください。物理キーの位置を採点します。D/Kは前置シフトなので、同時押しではなく順に押します。濁点はL、半濁点はLを2回。正しい別打鍵経路も受け付けます。誤打では進まないため、Backspaceでの修正は不要です。</p>
    <p><strong>集中：</strong>課題文と小さな残り時間を中心にしたシンプルな画面。初期設定は60秒、設定から30・60・120秒を選べます。最初の打鍵で計測が始まり、時間になると速度・正確率・次の改善点を表示して保存。結果画面でEnter、または「もう一度」のタップで同じ条件の新しい課題へ進みます。Escは練習中でも結果画面でも、同じ課題を最初から即リトライ。入力と残り時間をリセットし、次の打鍵から計測します。途中の記録は中断扱いで保存し、自己ベストに含めません。「中断する」・画面の切り替え・モード選択では再開せず終了します。自動再開や休憩の強制はしません。ガイドは初期状態で非表示、必要ならヒントを使えます。「モード選択」で履歴や詳しい使い方に戻れます。</p>
    <p><strong>弱点ドリル：</strong>PC・タップの記録から、ヒントなし正答率が90%未満のかな、本人の中央値より1.4倍以上遅いかな、1.5倍以上遅い2打鍵を最大6件選びます。絶対値ではなく本人比なので、上級者でも常に次の一手が出ます。選んだ弱点を含む語・短文を約7割、含まない文を約3割混ぜて45秒。結果では弱点ごとに、選定時の基準値とこの回の中央値を並べます。記録が少ないうちは弱点が選べず、通常の短文練習になります。</p>
    <p><strong>疾走（高速化モードの15秒）：</strong>30・60・120秒の高速化で残した比較可能な自己ベスト（正確率95%以上・ヒントなし）に8%を上乗せした値を目標に表示します。正確率が90%を切ったら速すぎ。目標を超えたら、同じ速さを60秒・正確率97%以上で保てるかを確かめてください。15秒の記録は同条件どうしでのみ比較し、他の秒数の自己ベストには含めません。</p>
    <p><strong>IME（入力方法で選択）：</strong><a href="/#get-started">新月配列を導入</a>した環境で日本語IMEをオンにし、表示の漢字・句読点まで入力します。他の配列でも動くため、配列の自動判定や本人確認はしていません。変換後の文字/分で測り、かな/分とは比較しません。</p>
    <p><strong>ガイドの読み方：</strong>次に押すキーは画面のキーボード上で光ります（開始前から表示）。ガイドはローマ字ではなく、そのキーが出す文字（★ / ☆ / か / が …）で示し、PC のときだけ物理キーの文字を小さく添えます。キーは担当する指ごとに色分け（小指・薬指・中指・人差し指、左右対称）。「」は実機どおり P の右です。</p>
    <p><strong>スマートフォン：</strong>画面タップで配置を学習できます。外付けキーボードも選べます。タップの記録はPCと独立し、PCの運動技能を同等に鍛えるものではありません。IME実践は端末の日本語キーボードを使います。</p>
    <p><strong>操作：</strong>開始後は最初の入力から計測。Escは集中モードで最初からリトライ、習得・復習で一時停止、その他の時間制テストで終了。Tabは通常のフォーカス移動に使えます。タイピング中に別の画面へ移動すると学習は停止、時間制テストは中断記録になり自己ベストから除外します。</p>
  </div></details>
  <details><summary>数字の読み方と、公平な比較</summary><div>
    <p>シミュレーターの速度＝完了したかな・句読点数÷計測分数。拗音は「きゃ」で2文字。正確率＝正しい打鍵÷全採点打鍵。ミスの修正待ち時間も含みます。英語の5文字＝1語換算のWPMではありません。最初の1秒は速度を表示しません。</p>
    <p>IME実践の速度＝変換後の正しく一致した先頭文字数÷計測分数。一致率＝現在までの確定入力の正しい先頭文字数÷確定入力文字数。これは修正後の値で、打鍵正確率ではありません。変換中の未確定文字は採点しません。短時間で終了した場合は参考記録です。</p>
    <p>グラフは累積平均速度。リズム値は正しい打鍵間隔のばらつきから計算する独自の参考値で、10標本未満は表示しません。ヒントあり・中断・正確率95%未満・15秒未満・10文字未満は自己ベスト／目標ペースから除外。入力方法・モード・秒数・段階・文章の種類の一致する記録だけを比べます。</p>
    <p>高速化モードは同じ設定でも文章が変わります。より条件を揃えて比べるには、固定文の定点測定を使ってください。ただし固定文も繰り返せば慣れるため、初見の能力を証明しません。別の文や実際の仕事での入力も確かめてください。予測変換・マクロを完全に検出する仕組みではなく、個人練習用です。</p>
  </div></details>
  <details id="lab-evidence"><summary>研究をどう取り入れたか — 根拠と限界</summary><div>
    <p>新月配列で「世界最速の習得」「医学的に最適」と実証された訓練法は確認できませんでした。このツール自体の学習効果も未検証です。以下の研究を設計の参考にし、出題比率・95%基準・休憩20秒・復習間隔は製品上の仮説として設定しています。</p>
    <ul>
      <li><a href="https://pubmed.ncbi.nlm.nih.gov/17924799/" target="_blank" rel="noopener noreferrer">Keith & Ericsson, 2007</a>：日常のタイピング経験と、向上を意図した練習を区別する研究。弱点を特定し、狙って練習する設計の参考です。新月配列での因果的な効果を保証しません。</li>
      <li><a href="https://userinterfaces.aalto.fi/136Mkeystrokes/" target="_blank" rel="noopener noreferrer">Dhakal et al., CHI 2018</a>：大規模な打鍵データの観察研究。誤打と2打鍵の分析を参考にしています。相関から特定の打ち方の優位性は断定しません。</li>
      <li><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC8259719/" target="_blank" rel="noopener noreferrer">Buch et al., 2021</a>：短い練習と休息を挟む運動系列課題。ただし<a href="https://pubmed.ncbi.nlm.nih.gov/41150724/" target="_blank" rel="noopener noreferrer">2025年の反証研究</a>もあり、休憩直後の速さを長期学習の証拠とは扱いません。「10秒休めば最速」等は主張しません。</li>
      <li><a href="https://gwern.net/doc/psychology/spaced-repetition/1979-shea.pdf" target="_blank" rel="noopener noreferrer">Shea & Morgan, 1979</a>・<a href="https://www.nature.com/articles/s41598-024-65753-3" target="_blank" rel="noopener noreferrer">2024年のメタ分析</a>：運動学習で、課題を混ぜて練習するほうが練習中の成績は下がっても保持・転移に有利という「文脈干渉効果」。弱点ドリルで得意な文を3割混ぜる根拠です。かな入力への直接の追試は確認できておらず、7：3の比率は製品上の仮説です。</li>
      <li>疾走（オーバースピード）：快適速度を超える短い練習で上限を押し上げる方法は、競技タイピングの実務知見で、査読研究は確認できませんでした。効果量・副作用（ミスの癖の定着）は未検証のため、正確率90%未満なら目標を下げる助言を出し、15秒の記録は他の秒数の自己ベストに含めません。</li>
      <li><a href="https://www.osha.gov/etools/computer-workstations/components/keyboards" target="_blank" rel="noopener noreferrer">OSHAのキーボード作業指針</a>：手首を自然に保ち、肩の力を抜き、短い休止を入れる考え方。痛みやしびれが出たら中止し、続く場合は医療専門家に相談してください。医療・リハビリ用のツールではありません。</li>
    </ul>
  </div></details>
  <details><summary>参考にしたサービス・ソースコード</summary><div>
    <p><a href="https://www.keybr.com/">keybr</a>の段階学習と文字別評価、<a href="https://monkeytype.com/">Monkeytype</a>の集中しやすい時間制テストとミス・遅い連続入力の復習、<a href="https://o24.works/atc/">ATC tester</a>の変換後の実入力計測、<a href="https://www.e-typing.ne.jp/">e-typing</a>の意味を持つ題材、<a href="https://sushida.net/">寿司打</a>の短い挑戦と即時の結果を参考にしました。各サービスと同一の採点方式ではありません。</p>
    <p>keybrのローカルフォーク（AGPL-3.0）とMonkeytype（GPL-3.0）の学習・入力・集計実装、ATCの公開クライアントスクリプトを調査。コード・問題文・画像は転載せず、新月配列の公式ローマ字テーブルから独立実装しています。e-typing／寿司打の非公開エンジンを解析・複製したものではありません。</p>
