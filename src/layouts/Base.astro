---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  robots?: string;
}

const {
  title,
  description,
  ogImage = "/og-default.png",
  robots = "index, follow",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://shingetsu-layout.com/#website",
  name: "新月配列",
  url: "https://shingetsu-layout.com",
  description: "JIS かなの 46 文字を 30 キーに収め、ホームポジションから指を離さず高速に日本語を入力できるキーボード配列",
  inLanguage: "ja",
  publisher: {
    "@type": "Person",
    "@id": "https://shingetsu-layout.com/#author",
    name: "nagamine",
    url: "https://github.com/nagamine-git",
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/moon-mark.svg?v=2" />
    <link rel="preload" href="/fonts/shippori-mincho-medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-sans-jp.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robots} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DDY9QM5CXR" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DDY9QM5CXR');
    </script>

    <!-- DNS prefetch for external resources -->
    <link rel="dns-prefetch" href="//challenges.cloudflare.com" />
    <link rel="dns-prefetch" href="//static.cloudflareinsights.com" />

    <!-- WebSite JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

    <!-- Page-specific head content (JSON-LD etc.) -->
    <slot name="head" />
  </head>
  <body data-home={Astro.url.pathname === "/" ? "true" : undefined}>
    <a href="#main-content" class="skip-link">本文へ移動</a>
    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer border-t border-white/10 mt-24 py-8 text-center text-sm text-slate-500">
      <div class="max-w-5xl mx-auto px-4">
        <p>
          &copy; 2026 新月配列 &mdash;
          <a
            href="https://github.com/nagamine-git/shingetsu-layout"
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:text-white transition-colors"
            data-track="github_click"
            data-track-loc="footer"
          >
            GitHub
          </a>
        </p>
      </div>
    </footer>

    <!-- AARRR 計測: track() ヘルパー + data-track 属性の汎用クリック計測 -->
    <script>
      import "../lib/reveal";

      window.track = (name, params = {}) => {
        // gtag 未ロード（広告ブロック等）でも落ちないように optional chaining
        window.gtag?.("event", name, params);
      };

      // data-track="<event>" を持つ要素のクリックを自動計測。
      // data-track-loc="<location>" があれば location パラメータとして送る。
      document.addEventListener("click", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-track]");
        if (!el) return;
        const name = el.dataset.track;
        if (!name) return;
        window.track(name, el.dataset.trackLoc ? { location: el.dataset.trackLoc } : {});
      });

    </script>
  </body>
</html>
